{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Metrics",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    }
  ],
  "id": null,
  "uid": "holos-gateway-production",
  "title": "Holos Gateway — production overview",
  "description": "Import recording-rules.yml first. Application metrics use stable OpenTelemetry HTTP conventions. Percentages are undefined without traffic. Infrastructure quota, restart, and OOM monitoring is deployment-specific.",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "holos",
    "opentelemetry"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(holos:telemetry_heartbeat, job)",
          "refId": "service"
        },
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "holos-api-gateway",
          "value": "holos-api-gateway"
        }
      },
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(holos:telemetry_heartbeat{job=~\"$service\"}, deployment_environment_name)",
          "refId": "environment"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "version",
        "label": "Version",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(holos:telemetry_heartbeat{job=~\"$service\",deployment_environment_name=~\"$environment\"}, service_version)",
          "refId": "version"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "worker",
        "label": "Worker",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(holos:telemetry_heartbeat{job=~\"$service\",deployment_environment_name=~\"$environment\",service_version=~\"$version\"}, instance)",
          "refId": "worker"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "route",
        "label": "Route",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(holos:http_requests:rate5m{job=~\"$service\",deployment_environment_name=~\"$environment\"}, http_route)",
          "refId": "route"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "probe_job",
        "label": "Probe job",
        "type": "textbox",
        "query": "holos-gateway-production",
        "current": {
          "text": "holos-gateway-production",
          "value": "holos-gateway-production"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Requests / second",
      "description": "Completed user requests. Health checks and API documentation are excluded. Counts come from the HTTP duration histogram.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(holos:http_requests:rate5m{job=~\"$service\",deployment_environment_name=~\"$environment\",service_version=~\"$version\",instance=~\"$worker\",http_route=~\"$route\"})",
          "legendFormat": "",
          "refId": "A",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No traffic / no data",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "HTTP success",
      "description": "2xx and 3xx responses divided by all completed user requests. No traffic produces no percentage.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "(sum(holos:http_requests:rate5m{job=~\"$service\",deployment_environment_name=~\"$environment\",service_version=~\"$version\",instance=~\"$worker\",http_route=~\"$route\",http_response_status_code=~\"[23]..\"}) or (0 * sum(holos:http_requests:rate5m{job=~\"$service\",deployment_environment_name=~\"$environment\",service_version=~\"$version\",instance=~\"$worker\",http_route=~\"$route\"}))) / (sum(holos:http_requests:rate5m{job=~\"$service\",deployment_environment_name=~\"$environment\",service_version=~\"$version\",instance=~\"$worker\",http_route=~\"$route\"}) > 0)",
          "legendFormat": "",
          "refId": "A",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No traffic / no data",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "4xx responses",
      "description": "Invalid requests, access denial, missing routes, and other 4xx outcomes. These are separate from server failures. No traffic produces no percentage.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "(sum(holos:http_requests:rate5m{job=~\"$service\",deployment_environment_name=~\"$environment\",service_version=~\"$version\",instance=~\"$worker\",http_route=~\"$route\",http_response_status_code=~\"4..\"}) or (0 * sum(holos:http_requests:rate5m{job=~\"$service\",deployment_environment_name=~\"$environment\",service_version=~\"$version\",instance=~\"$worker\",http_route=~\"$route\"}))) / (sum(holos:http_requests:rate5m{job=~\"$service\",deployment_environment_name=~\"$environment\",service_version=~\"$version\",instance=~\"$worker\",http_route=~\"$route\"}) > 0)",
          "legendFormat": "",
          "refId": "A",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No traffic / no data",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Server failures",
      "description": "5xx responses divided by all completed user requests. No traffic produces no percentage.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "(sum(holos:http_requests:rate5m{job=~\"$service\",deployment_environment_name=~\"$environment\",service_version=~\"$version\",instance=~\"$worker\",http_route=~\"$route\",http_response_status_code=~\"5..\"}) or (0 * sum(holos:http_requests:rate5m{job=~\"$service\",deployment_environment_name=~\"$environment\",service_version=~\"$version\",instance=~\"$worker\",http_route=~\"$route\"}))) / (sum(holos:http_requests:rate5m{job=~\"$service\",deployment_environment_name=~\"$environment\",service_version=~\"$version\",instance=~\"$worker\",http_route=~\"$route\"}) > 0)",
          "legendFormat": "",
          "refId": "A",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No traffic / no data",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Traffic by route",
      "description": "Five-minute request rates. A missing route label represents an unmatched request.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (http_route) (holos:http_requests:rate5m{job=~\"$service\",deployment_environment_name=~\"$environment\",service_version=~\"$version\",instance=~\"$worker\",http_route=~\"$route\"})",
          "legendFormat": "{{http_route}}",
          "refId": "A",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No traffic / no data",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Response codes",
      "description": "Volume by status code; compare client errors with server failures.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (http_response_status_code) (holos:http_requests:rate5m{job=~\"$service\",deployment_environment_name=~\"$environment\",service_version=~\"$version\",instance=~\"$worker\",http_route=~\"$route\"})",
          "legendFormat": "{{http_response_status_code}}",
          "refId": "A",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No traffic / no data",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Response time percentiles",
      "description": "p95 is the time within which approximately 95% of requests finish. Histogram buckets are summed across workers before computing percentiles.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (holos:http_duration_bucket:rate5m{job=~\"$service\",deployment_environment_name=~\"$environment\",service_version=~\"$version\",instance=~\"$worker\",http_route=~\"$route\"}))",
          "legendFormat": "p50",
          "refId": "A",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (holos:http_duration_bucket:rate5m{job=~\"$service\",deployment_environment_name=~\"$environment\",service_version=~\"$version\",instance=~\"$worker\",http_route=~\"$route\"}))",
          "legendFormat": "p95",
          "refId": "B",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (holos:http_duration_bucket:rate5m{job=~\"$service\",deployment_environment_name=~\"$environment\",service_version=~\"$version\",instance=~\"$worker\",http_route=~\"$route\"}))",
          "legendFormat": "p99",
          "refId": "C",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No traffic / no data",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Active requests by worker",
      "description": "Requests currently in the application. Independent of the route filter because routing may not have completed yet. Periodic export can miss short spikes.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "holos:active_requests{job=~\"$service\",deployment_environment_name=~\"$environment\",service_version=~\"$version\",instance=~\"$worker\"}",
          "legendFormat": "{{instance}}",
          "refId": "A",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No traffic / no data",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "CPU cores by worker",
      "description": "CPU seconds per second, summed over user and system modes. 1 means one fully occupied CPU core. This is not percent of a container quota.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "holos:process_cpu:cores5m{job=~\"$service\",deployment_environment_name=~\"$environment\",service_version=~\"$version\",instance=~\"$worker\"}",
          "legendFormat": "{{instance}}",
          "refId": "A",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cores",
          "noValue": "No traffic / no data",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Physical memory by worker",
      "description": "Resident process memory (RSS). Summing worker RSS can double count shared pages; use container metrics for memory-limit alerts.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "holos:process_memory:bytes{job=~\"$service\",deployment_environment_name=~\"$environment\",service_version=~\"$version\",instance=~\"$worker\"}",
          "legendFormat": "{{instance}}",
          "refId": "A",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "No traffic / no data",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Event loop delay p95",
      "description": "Delay of a one-second scheduler probe. Sustained high delay can indicate blocking code or CPU pressure.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (instance, le) (holos:event_loop_delay_bucket:rate5m{job=~\"$service\",deployment_environment_name=~\"$environment\",service_version=~\"$version\",instance=~\"$worker\"}))",
          "legendFormat": "{{instance}}",
          "refId": "A",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No traffic / no data",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Thread pool usage",
      "description": "Borrowed tokens divided by default AnyIO thread limiter capacity. This measures synchronous endpoint and thread-offloaded work.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "holos:thread_pool_busy{job=~\"$service\",deployment_environment_name=~\"$environment\",service_version=~\"$version\",instance=~\"$worker\"} / holos:thread_pool_capacity{job=~\"$service\",deployment_environment_name=~\"$environment\",service_version=~\"$version\",instance=~\"$worker\"}",
          "legendFormat": "{{instance}}",
          "refId": "A",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No traffic / no data",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Thread pool waiting tasks",
      "description": "Tasks waiting for a default thread limiter token. One-second sampling can miss short queues; sustained waiting is an overload signal.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "holos:thread_pool_waiting{job=~\"$service\",deployment_environment_name=~\"$environment\",service_version=~\"$version\",instance=~\"$worker\"}",
          "legendFormat": "{{instance}}",
          "refId": "A",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No traffic / no data",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Open file descriptors",
      "description": "Open sockets and files per worker, on supported operating systems. Compare with deployment limits before defining an alert.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "holos:open_file_descriptors{job=~\"$service\",deployment_environment_name=~\"$environment\",service_version=~\"$version\",instance=~\"$worker\"}",
          "legendFormat": "{{instance}}",
          "refId": "A",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No traffic / no data",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Worker uptime",
      "description": "Time since telemetry initialized. Use platform restart/OOM events for reliable restart alerts, rather than inferring restarts from disappearing workers.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "holos:worker_uptime:seconds{job=~\"$service\",deployment_environment_name=~\"$environment\",service_version=~\"$version\",instance=~\"$worker\"}",
          "legendFormat": "{{instance}}",
          "refId": "A",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
